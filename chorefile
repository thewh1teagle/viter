# viter tasks. Run `chore list` to see them.
require 1.7.0

# LJSpeech setup used for parity work (see plans/parity/README.md).
corpus=data/ljfull
dict=data/dict/ljspeech_ipa_noprobs.dict
mfa_tg=data/mfa-ljspeech/textgrids
# Latest full-schedule model and its training-time TextGrids.
model=data/ljfull-v12.viter
train_tg=data/ljfull-v12-tg
out=data/ljfull-aligned

# Build the web viewer into web/dist (embedded into the binary).
task web {
    cd web
    exists node_modules || pnpm install
    pnpm build
}

# Build the release binary (fast profile; builds the web viewer first).
task build {
    web
    cargo build --release
}

# Ship-quality binary: fat LTO, stripped (what the release workflow uses).
task dist {
    web
    cargo build --profile dist
}

# Type-check the workspace.
task check {
    exists web/dist || web
    cargo check --workspace --all-targets
}

# Run the Rust unit tests.
task test {
    exists web/dist || web
    cargo test --workspace
}

# Format and lint the way CI does.
task lint {
    exists web/dist || web
    cargo fmt --all -- --check
    cargo clippy --workspace --all-targets
    cd web
    pnpm exec tsc -b
}

# Train on full LJSpeech with MFA's schedule (the parity config, ~10 min on a GPU):
# train [out_model] [out_textgrids].
task train model=$model tg=$train_tg {
    build
    remove $2
    target/release/viter train $corpus --dict $dict --no-position-dependent -o $1 --out-textgrids $2 --log $1.log
}

# Same, short schedule (~2 min, ~70% parity): train-fast [out_model].
task train-fast model=data/ljfull-fast.viter {
    build
    target/release/viter train $corpus --dict $dict --no-position-dependent --sat-rounds 1 --no-pron-probs -o $1
}

# Align the corpus with the latest model: align [model] [out].
task align model=$model out=$out {
    exists target/release/viter || build
    remove $2
    target/release/viter align $corpus $1 --dict $dict -o $2
}

# Build the python wheel into dist/ (builds the web viewer first).
task wheel {
    exists web/dist || web
    uv build --wheel
}

# Run the python tests against the freshly built wheel.
task pytest {
    wheel
    uv run --with dist/*.whl --with pytest --with numpy pytest tests/python -q
}

# Parity of a TextGrid folder against MFA's: parity [textgrids].
task parity tg=$train_tg {
    uv run plans/parity/parity_001.py $1 $mfa_tg
    uv run plans/parity/parity_003_silences.py $1 $mfa_tg
    uv run plans/parity/parity_002_breakdown.py $1 $mfa_tg
}

# Feature parity of viter's MFCC pipeline against Kaldi binaries.
task parity-feats {
    uv run plans/parity/parity_004_feats.py
}

# Per-phone gaussian allocation and transition probs of a model: inspect [model].
task inspect model=$model {
    cargo run --release -q -p viter-kaldi --example inspect -- $1
}

# Serve a training TextGrid folder with audio taken from the corpus: serve [textgrids].
task serve tg=$train_tg {
    exists target/release/viter || build
    target/release/viter serve $1 --audio $corpus --no-open
}

# Serve viter vs MFA side by side (tiers: words, phones, mfa words, mfa phones).
task compare-serve {
    exists target/release/viter || build
    target/release/viter serve data/demo-compare --port 7879 --no-open
}

# Rebuild data/demo-compare from a TextGrid folder (40 files): compare-build [textgrids].
task compare-build tg=$train_tg {
    uv run plans/parity/compare_build.py $1
}

# Web dev server with /api proxied to a running `viter serve`.
task web-dev {
    cd web
    exists node_modules || pnpm install
    pnpm dev
}

# Delete build output.
task clean {
    remove target web/dist
}
